# agentic-video-maker — environment variables
# Copy this file to .env and fill in your keys. Then `source .env` before running.

# === Required ===

# Google AI Studio (Director, Prompt Engineer, Video critique, transcription)
# Get at: https://aistudio.google.com
GEMINI_API_KEY=

# ElevenLabs (narration via eleven_v3 + Music API for soundtracks)
# Get at: https://elevenlabs.io → Profile → API Keys
ELEVENLABS_API_KEY=

# fal.ai (FLUX schnell, nano-banana 2, LTX-2)
# Get at: https://fal.ai → Dashboard → API Keys
FAL_KEY=

# ElevenLabs voice ID for narration.
# Browse public voices at: https://elevenlabs.io/app/voice-library
# Examples: 21m00Tcm4TlvDq8ikWAM (Rachel, English-trained — not ideal for Hebrew)
# For Hebrew: pick a multilingual voice and verify quality.
VOICE_ID=

# === Optional ===

# xAI / Grok Imagine — only needed for --quality premium|ultra (video gen)
# Get at: https://x.ai/api
# XAI_API_KEY=

# Override critique model (defaults to gemini-2.5-flash — fast + cheap)
# GEMINI_CRITIQUE_MODEL=gemini-2.5-pro

# Caption font (fontconfig family name). Default: Heebo.
# Install on the host first (e.g. `apt install fonts-heebo` on Debian/Ubuntu).
# CAPTION_FONT_NAME=Heebo

# Motion-graphics fonts (absolute paths to OTF/TTF). Optional — defaults to browser fonts.
# FONT_HEAVY=/path/to/heavy.otf
# FONT_BOLD=/path/to/bold.otf
# FONT_LIGHT=/path/to/light.otf
# FONT_SERIF=/path/to/serif.otf

# Title font for intro/outro cards (absolute path to OTF/TTF).
# TITLE_FONT_FILE=/path/to/title.otf
